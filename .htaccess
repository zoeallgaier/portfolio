# ── Browser cache policy ──────────────────────────────────────────────────
# SiteGround serves assets with a 6-month–1-year cache by default, which meant
# CSS/JS changes and — critically — new content.json entries (phone posts) did
# not reach returning visitors. Markup, code, and feed data now revalidate on
# every load (ETag/Last-Modified still make unchanged fetches a cheap 304), so
# updates appear immediately. Images keep the long cache (their filenames are
# stable/unique, so they never go stale).
<IfModule mod_headers.c>
  # Probe: if this header shows up in responses, .htaccess is being honored.
  Header set X-Cache-Test "htaccess-live"

  <FilesMatch "\.(html|json|css|js)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>

  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
